# ===== 依赖 =====
node_modules/

# ===== 构建产物 =====
# 使用 Cloudflare Pages / Vercel 等平台自动构建，dist 由平台生成，不提交
dist/

# ===== 日志 =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== 编辑器 / IDE =====
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ===== VSCode 插件构建产物 =====
extension/media/
extension/dist/
extension/node_modules/
*.vsix
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/
*.iml

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 环境变量 / 本地配置 =====
# 各环境基础配置（.env.development/.env.test/.env.production）入库，仅含非敏感的地址类配置；
# .env 与 *.local 为本地私有覆盖，不入库。新增环境模式时需在此追加对应白名单
.env
.env.local
.env.*.local
!.env.example
!.env.development
!.env.test
!.env.production
